    "TUNNEL_REQUIRED": {
      "code": "TUNNEL_REQUIRED",
      "title": "This device needs the privileged tunnel",
      "body": "On iOS 17 and newer, screenshots need a system tunnel that must run as root. It stops when you quit the helper.",
