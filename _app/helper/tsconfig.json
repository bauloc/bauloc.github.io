{
  /*
    The real settings are in ../tsconfig.helper.json, which `npm run typecheck:helper` uses.

    This file exists because editors and ESLint's project service look for the nearest file
    named tsconfig.json. Without it they would find ../tsconfig.json, which covers only the
    page (src/), and either type the helper against the DOM or refuse to lint it. `include`
    is inherited, resolved against the file that declares it.
  */
  "extends": "../tsconfig.helper.json"
}
