# Contact form delivery through a Telegram bot — src/features/profile/contact.ts.
# Copy to .env (git-ignored) and fill BOTH to send messages to Telegram, as the old Flutter
# profile did. Leave them unset and the form opens the visitor's mail app instead.
#
# The site is static: whatever is set here is inlined into the published JavaScript under
# /assets/ and is readable by anyone who opens the page. Only set a token you accept as public.
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
